    "    titulos_por_perfil=(\"titulos\", \"mean\")).reindex(ORDEN_NOMBRES)\n",
    "display(resultados.round(3))\n",
    "\n",
    "# La misma tabla sin Federer, Nadal y Djokovic (se sacan sus perfiles en las tres superficies)\n",
    "sin_big3 = X[~X[\"nombre\"].isin([\"Roger Federer\", \"Rafael Nadal\", \"Novak Djokovic\"])]\n",
