   "source": [
    "autovalores = componentes.explained_variance_\n",
    "tabla_pca = pd.DataFrame({\"% de la varianza\": var * 100,\n",
    "                          \"% acumulado\": np.cumsum(var) * 100,\n",
    "                          \"autovalor\": autovalores},\n",
    "                         index=[f\"PC{i}\" for i in range(1, len(var) + 1)])\n",
    "display(tabla_pca.round(2))\n",
    "\n",
    "N_COMP = int((autovalores > 1).sum())\n",
    "NOMBRES_PC = [f\"PC{i}\" for i in range(1, N_COMP + 1)]\n",
    "cargas_k = pd.DataFrame(componentes.components_[:N_COMP].T, index=[ETIQUETAS[c] for c in COLUMNAS], columns=NOMBRES_PC)\n",
    "display(cargas_k.style.format(\"{:.2f}\").background_gradient(cmap=\"RdBu_r\", vmin=-.7, vmax=.7))\n",
    "\n",
    "# dónde cae cada estilo en las componentes conservadas (promedio de sus perfiles)\n",
    "medias_pc = pd.DataFrame(pca.transform(X)[:, :N_COMP], columns=NOMBRES_PC, index=X.index)\n",
    "medias_pc = medias_pc.groupby(X[\"estilo\"], observed=True).mean().reindex(ORDEN_NOMBRES)\n",
    "display(medias_pc.round(2))\n",
    "\n",
    "c3 = cargas_k[NOMBRES_PC[-1]]\n",
    "lado = c3[c3.abs() > .3]\n",
    "ultima = NOMBRES_PC[-1]\n",
    "texto(f\"Se conservan **{N_COMP} componentes**: son las únicas con autovalor mayor que 1, y la siguiente tiene \"\n",
    "      f\"{autovalores[N_COMP]:.2f}, es decir, explica menos que una columna sola. Juntas explican el \"\n",
    "      f\"**{np.cumsum(var)[N_COMP - 1]:.0%}** de las diferencias entre perfiles.\\n\\n\"\n",
    "      f\"**{ultima}** opone *{', '.join(lado[lado > 0].index)}* a *{', '.join(lado[lado < 0].index)}*: \"\n",
    "      \"un primer saque que entra mucho pero no se traduce en puntos ganados. Es la componente más difícil de nombrar, \"\n",
    "      f\"y los tres estilos tienen promedio cercano a 0 en ella (entre {medias_pc[ultima].min():.2f} y \"\n",
    "      f\"{medias_pc[ultima].max():.2f}): **no separa a los estilos**. Los tres viven en el plano PC1–PC2: \"\n",
    "      f\"los sacadores se apartan por PC1 ({medias_pc.loc['Sacadores de potencia', 'PC1']:+.2f}) y los restadores \"\n",
    "      f\"sólidos y el saque frágil se separan por PC2 ({medias_pc.loc['Restadores sólidos', 'PC2']:+.2f} contra \"\n",
