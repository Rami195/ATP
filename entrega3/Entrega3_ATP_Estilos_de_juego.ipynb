    "    grupos = pd.Series(lab[lab >= 0]).value_counts()\n",
    "    filas.append({\"eps\": eps, \"grupos\": len(grupos), \"perfiles en el grupo mayor\": int(grupos.max()) if len(grupos) else 0,\n",
    "                  \"ruido\": int((lab == -1).sum()), \"% ruido\": (lab == -1).mean() * 100})\n",
