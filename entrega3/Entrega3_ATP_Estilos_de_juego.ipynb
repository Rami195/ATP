     "output_type": "display_data"
    }
   ],
   "source": [
    "# Altura por estilo: variable para MIRAR los grupos, no entró a la distancia (validación externa de H4)\n",
    "altura = (X[[\"id\"]]\n",
    "          .merge(df[[\"id-jugador\", \"altura-cm\"]], left_on=\"id\", right_on=\"id-jugador\", how=\"left\")[\"altura-cm\"])\n",
    "\n",
    "# 1) Altura promedio de cada estilo\n",
    "display(pd.DataFrame({\"estilo\": X[\"estilo\"], \"altura\": altura})\n",
    "        .groupby(\"estilo\", observed=True)[\"altura\"]\n",
    "        .agg(altura_media=\"mean\", altura_mediana=\"median\")\n",
    "        .reindex(ORDEN_NOMBRES)\n",
    "        .style.format(\"{:.1f} cm\"))\n",
    "\n",
    "# 2) Qué porcentaje de cada estilo cae en cada rango de altura (cada fila suma 100 %)\n",
    "RANGOS = [\"menos de 180\", \"180 a 184\", \"185 a 189\", \"190 a 194\", \"195 o más\"]\n",
    "rango = (pd.cut(altura, bins=[0, 180, 185, 190, 195, 300], right=False, labels=RANGOS)\n",
    "         .cat.add_categories(\"No especificado\").fillna(\"No especificado\"))\n",
    "display((pd.crosstab(X[\"estilo\"], rango, normalize=\"index\") * 100)\n",
    "        .reindex(ORDEN_NOMBRES)\n",
    "        .style.format(\"{:.1f} %\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "md030",
   "metadata": {},
   "source": [
    "## Parte 4 — Una proyección para mirar\n",
    "\n",
    "Siete columnas no se pueden dibujar. **PCA** busca las direcciones en las que los perfiles más se diferencian.\n",
    "Se ajusta sobre los datos ya estandarizados (el pipeline sin su último paso) y solo se usa para *mirar*:\n",
    "**el agrupamiento se hizo en las siete dimensiones, no en estas dos**."
   ]
  },
