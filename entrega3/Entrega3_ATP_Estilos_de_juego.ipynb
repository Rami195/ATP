    "# Qué fracción de cada superficie cae en cada estilo (las columnas suman 100 %)\n",
    "display((pd.crosstab(X[\"estilo\"], X[\"superficie\"], normalize=\"columns\") * 100).round(1))\n",
    "\n",
    "resultados = X.groupby(\"estilo\", observed=True).agg(\n",
